{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".node-version"],
  "globalEnv": ["NODE_VERSION"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "lint": {},
    "test": {
      "outputs": ["coverage/**"]
    }
  }
}
