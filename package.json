{
  "name": "talktally",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lint": "turbo run lint && eslint scripts *.config.js && prettier --check .",
    "format": "prettier --write .",
    "check:versions": "node scripts/check-single-versions.mjs",
    "check:architecture": "depcruise apps packages --config dependency-cruiser.config.js",
    "check:unused": "knip"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@talktally/config": "workspace:*",
    "dependency-cruiser": "^18.7.2",
    "eslint": "catalog:",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "prettier": "catalog:",
    "turbo": "^2.11.0",
    "typescript": "catalog:"
  }
}
